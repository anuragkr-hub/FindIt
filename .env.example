# FindIt Environment Configuration Example
# Copy this file to .env and adjust values for your environment

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL 8)
DB_URL=jdbc:mysql://localhost:3306/findit_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# File Upload Storage
APP_UPLOAD_DIR=uploads

# Sample Seed Data (true for local development, false for production)
APP_SEED_DATA=true

# Real Email SMTP Configuration (For Real Inbox OTP Delivery)
# For Gmail: Use your Gmail address and generate a 16-character App Password at:
# Google Account -> Security -> 2-Step Verification -> App passwords
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your.email@gmail.com
SPRING_MAIL_PASSWORD=your_16_char_google_app_password
APP_MAIL_FROM=noreply.findit.campus@gmail.com
