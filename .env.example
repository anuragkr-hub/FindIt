# FindIt Environment Configuration Example
# Copy this file to .env and adjust values for your environment

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL 8)
DB_URL=jdbc:mysql://localhost:3306/findit_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# File Upload Storage
APP_UPLOAD_DIR=uploads

# Sample Seed Data (true for local development, false for production)
APP_SEED_DATA=true
